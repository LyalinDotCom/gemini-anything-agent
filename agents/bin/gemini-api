#!/usr/bin/env bash
set -euo pipefail

# All managed profiles use this checksum-verified official Go CLI.
# Both harnesses mount this exact launcher.
if [ "${GEMINI_API_KEY:-}" = "PLACEHOLDER" ]; then unset GEMINI_API_KEY; fi
if [ -f /.env ]; then set -a; . /.env; set +a; fi
if [ "${GEMINI_API_KEY:-}" = "PLACEHOLDER" ]; then unset GEMINI_API_KEY; fi

version=0.4.2
cache="${GEMINI_API_CLI_CACHE:-/workspace/.tools/gemini-api}"
binary="$cache/$version/gemini-api"
if [ ! -x "$binary" ]; then
  case "$(uname -s)" in Linux) os=Linux ;; Darwin) os=Darwin ;; *) echo "Unsupported Gemini API CLI platform" >&2; exit 1 ;; esac
  case "$(uname -m)" in x86_64|amd64) arch=x86_64 ;; aarch64|arm64) arch=arm64 ;; *) echo "Unsupported Gemini API CLI architecture" >&2; exit 1 ;; esac
  archive="gemini-api_${os}_${arch}.tar.gz"
  base="https://github.com/google-gemini/gemini-api-cli/releases/download/v$version"
  mkdir -p "$cache/$version"
  staging=$(mktemp -d "$cache/.install.XXXXXX")
  trap 'rm -rf "$staging"' EXIT
  curl -fLsS --retry 3 --connect-timeout 30 --max-time 300 "$base/$archive" -o "$staging/$archive"
  curl -fLsS --retry 3 --connect-timeout 30 --max-time 120 "$base/checksums.txt" -o "$staging/checksums.txt"
  awk -v name="$archive" '$2 == name { print }' "$staging/checksums.txt" > "$staging/selected.sha256"
  [ -s "$staging/selected.sha256" ] || { echo "Release checksum missing for $archive" >&2; exit 1; }
  if command -v sha256sum >/dev/null 2>&1; then
    (cd "$staging" && sha256sum -c selected.sha256) >&2
  else
    (cd "$staging" && shasum -a 256 -c selected.sha256) >&2
  fi
  tar -xzf "$staging/$archive" -C "$staging" gemini-api
  chmod +x "$staging/gemini-api"
  mv "$staging/gemini-api" "$binary"
  rm -rf "$staging"
  trap - EXIT
fi
export GEMINI_CLI_AGENT_MODE=1
exec "$binary" --no-interactive "$@"
